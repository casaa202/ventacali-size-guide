            <tr><td>M</td><td>6–8</td><td>37.0</td><td>29.9</td><td>40.2</td><td>34.1</td></tr>
            <tr><td>L</td><td>10–12</td><td>39.4</td><td>32.3</td><td>42.5</td><td>34.6</td></tr>
            <tr><td>XL</td><td>14–16</td><td>42.5</td><td>35.4</td><td>45.7</td><td>35.2</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Body Measurement Tables -->
      <div id="measurements-cm" class="tab-section">
        <table>
          <thead><tr><th>Talla</th><th>US</th><th>EU</th><th>Busto</th><th>Cintura</th><th>Cadera</th></tr></thead>
