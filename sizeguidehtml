<style>
  .size-guide {
    font-family: sans-serif;
    color: #000;
    max-width: 1000px;
    margin: auto;
  }
  .tabs {
    display: flex;
    border-bottom: 1px solid #ccc;
    margin-top: 20px;
  }
  .tabs button {
    background: none;
    border: none;
    font-weight: 600;
    padding: 10px 20px;
    cursor: pointer;
    color: #999;
  }
  .tabs button.active {
    color: #000;
    border-bottom: 2px solid #000;
  }
  .unit-switch {
    margin: 20px 0;
  }
  .unit-switch button {
    padding: 5px 10px;
    margin-right: 10px;
    font-weight: bold;
    border: 1px solid #000;
    background-color: #fff;
    color: #000;
    cursor: pointer;
  }
  .unit-switch button.active {
    background-color: #000;
    color: #fff;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th, td {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid #ccc;
  }
  .tab-section {
    display: none;
  }
  .tab-section.active {
    display: block;
  }
  .guide-layout {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
  }
  .guide-table {
    flex: 1 1 500px;
  }
  .guide-image {
    flex: 1 1 300px;
    font-size: 14px;
  }
  .guide-image img {
    width: 120px;
    margin-bottom: 10px;
  }
  .note {
    font-size: 12px;
    color: #666;
    margin-top: 15px;
  }

  @media (max-width: 768px) {
    .guide-layout {
      flex-direction: column;
    }
    .tabs {
      justify-content: center;
    }
    .unit-switch {
      text-align: center;
    }
    .guide-image {
      text-align: center;
    }
  }
</style>

<div class="size-guide">
  <h2 style="font-size: 24px; font-weight: 600;">Guía de Tallas</h2>

  <!-- Tabs -->
